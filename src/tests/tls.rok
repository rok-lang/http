// HTTPS on loopback: ALPN picks HTTP/1.1 or HTTP/2, certificates are
// checked, a peer's KeyUpdate does not hold up writes. tests/tls/ holds
// an ECDSA P-256 CA and two leaves for localhost and 127.0.0.1 (valid to
// 2126): P-256 (`cert.pem`) and Ed25519.

use rok::std::fs;
use rok::std::net;
use rok::std::net::tls;
use rok::std::io::byte_buf;
use pkg::*;
use pkg::conn::{Io, connect, start_tls};
use pkg::tls::Side;
use sup::expect;
use sup::h1::test_handler;

fn server_tls(leaf: str = "") -> tls::ServerConfig {
    let chain = try! tls::Certificate::from_pem(try! fs::read_to_str(f"tests/tls/{leaf}cert.pem"));
    tls::ServerConfig::new(chain, try! tls::PrivateKey::from_pem(try! fs::read_to_str(f"tests/tls/{leaf}key.pem")))
}

fn client_tls() -> tls::ClientConfig {
    let cfg = tls::ClientConfig::new();
    cfg.root_certs = try! tls::Certificate::from_pem(try! fs::read_to_str("tests/tls/ca.pem"));
    cfg
}

fn trusting() -> Client { Client::with_tls(client_tls()) }

fn serve_https(cfg: ServerConfig | none = none, leaf: str = "") -> (Server, str) {
    let s = try! Server::bind_tls("127.0.0.1:0", test_handler, server_tls(leaf), cfg);
    let a = try! s.local_addr();
    task::spawn(async {
        try! await s.run();
        0
    });
    (s, f"https://{a}")
}

#[test]
fn https_h1() {
    task::block_on(async {
        let (srv, base) = serve_https(ServerConfig { http2: false });
        let c = trusting();
        let r = try! await c.get(base + "/hi?x=1");
        expect(r.version == Version::Http11 && r.status == StatusCode::OK, "status");
        expect((try! await r.body.text()).starts_with("GET /hi?x=1 HTTP/1.1 host=127.0.0.1:"), "body");
        let e = try! await c.send((try! Request::post(base + "/echo")).text("ping"));
        expect(try! await e.body.text() == "ping", "echo");
        let big = try! await c.get(base + "/big");
        let bb = try! await big.body.bytes();
        expect(bb.len() == 200000 && bb[199999] == (199999 % 251) as u8, f"big {bb.len()}");
        let s = try! await c.get(base + "/stream");
        expect((try! await s.body.text()).lines().count() == 50, "chunked");
        expect(c.idle_count(base) == 1, "kept alive");
        let r2 = try! await c.get(base + "/redirect");
        expect((try! await r2.body.text()).starts_with("GET /final?from=r HTTP/1.1"), "redirect");
        await srv.shutdown();
    });
}

#[test]
fn https_h2() {
    task::block_on(async {
        let (srv, base) = serve_https();
        let c = trusting();
        let r = try! await c.get(base + "/hi");
        expect(r.version == Version::Http2 && r.status == StatusCode::OK, "h2 chosen by ALPN");
        expect((try! await r.body.text()).starts_with("GET /hi HTTP/2 host=127.0.0.1:"), "body");
        let up: List<u8> = List::with_capacity(3000000);
        for i in 0..3000000 { up.push((i % 7) as u8); }
        let u = try! await c.send((try! Request::post(base + "/echo")).with_body(Body::from_bytes(up)));
        expect((try! await u.body.bytes()).len() == 3000000, "upload");
        let tasks: List<Task<bool>> = List::new();
        for i in 0..20 {
            tasks.push(task::spawn(async {
                let r = try! await c.get(base + f"/n{i}");
                (try! await r.body.text()).starts_with(f"GET /n{i} ")
            }));
        }
        let ok = 0;
        for x in await task::join(tasks) {
            if x { ok += 1; }
        }
        expect(ok == 20, f"concurrent {ok}");
        let slow = task::spawn(async { (try! await c.get(base + "/slow")).status.as_u16() });
        await task::sleep(Duration::ms(100));
        await srv.shutdown();
        expect(await slow == 200u16, "in-flight stream completed after GOAWAY");
    });
}

#[test]
fn https_untrusted() {
    task::block_on(async {
        let (srv, base) = serve_https();
        // The OS trust store does not know the test CA.
        let k = await sup::h1::err_kind(Client::new(), base + "/");
        expect(k == ErrorKind::Tls, f"{k:?}");
        await srv.shutdown();
    });
}

#[test]
fn https_ed25519() {
    task::block_on(async {
        let (srv, base) = serve_https(none, "ed25519-");
        let r = try! await trusting().get(base + "/ed");
        expect(r.version == Version::Http2 && (try! await r.body.text()).starts_with("GET /ed HTTP/2"), "Ed25519 leaf");
        await srv.shutdown();
    });
}

/// The peer sends a KeyUpdate and nothing else while we wait to read:
/// our write must still go out.
#[test]
fn key_update_does_not_block_writes() {
    task::block_on(async {
        let l = try! net::tcp_listen("127.0.0.1:0");
        let addr = try! l.local_addr();
        let peer = task::spawn_local(async {
            let (s, _) = try! await l.accept_async();
            let t = try! await tls::Server::new_async(s, server_tls());
            try! await t.key_update_async();
            let buf = byte_buf(16);
            let n = try! await t.read_async(buf);
            try! await t.write_all_async(f"got {try! str::from_utf8(buf[0:n])}");
            try! await t.close_notify_async();
            0
        });
        let io = try! await connect("127.0.0.1", addr.port(), none);
        io = try! await start_tls(io, Side::Client("localhost", client_tls()), none);
        let reading = spawn_read(io);
        await task::sleep(Duration::ms(100));
        try! await io.write("ping".as_bytes(), Instant::now().checked_add(Duration::sec(2)));
        expect(await reading, "read after the KeyUpdate");
        expect(try! str::from_utf8(io.peek()) == "got ping", "reply");
        io.close();
        await peer;
    });
}

fn spawn_read(io: Io) -> Task<bool> {
    task::spawn_local(async { try! await io.fill(Instant::now().checked_add(Duration::sec(5))) })
}
