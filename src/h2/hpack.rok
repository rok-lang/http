// HPACK (RFC 7541): header compression for HTTP/2.

use pkg::error::{HttpError, ErrorKind};
use pkg::h2::huffman;
use pkg::uri::utf8_lossy;

/// The static table (Appendix A), index 1..=61.
const STATIC: [(str, str); 61] = [
    (":authority", ""), (":method", "GET"), (":method", "POST"), (":path", "/"), (":path", "/index.html"),
    (":scheme", "http"), (":scheme", "https"), (":status", "200"), (":status", "204"), (":status", "206"),
    (":status", "304"), (":status", "400"), (":status", "404"), (":status", "500"), ("accept-charset", ""),
    ("accept-encoding", "gzip, deflate"), ("accept-language", ""), ("accept-ranges", ""), ("accept", ""),
    ("access-control-allow-origin", ""), ("age", ""), ("allow", ""), ("authorization", ""), ("cache-control", ""),
    ("content-disposition", ""), ("content-encoding", ""), ("content-language", ""), ("content-length", ""),
    ("content-location", ""), ("content-range", ""), ("content-type", ""), ("cookie", ""), ("date", ""),
    ("etag", ""), ("expect", ""), ("expires", ""), ("from", ""), ("host", ""), ("if-match", ""),
    ("if-modified-since", ""), ("if-none-match", ""), ("if-range", ""), ("if-unmodified-since", ""),
    ("last-modified", ""), ("link", ""), ("location", ""), ("max-forwards", ""), ("proxy-authenticate", ""),
    ("proxy-authorization", ""), ("range", ""), ("referer", ""), ("refresh", ""), ("retry-after", ""),
    ("server", ""), ("set-cookie", ""), ("strict-transport-security", ""), ("transfer-encoding", ""),
    ("user-agent", ""), ("vary", ""), ("via", ""), ("www-authenticate", ""),
];

fn err(msg: str) -> HttpError { HttpError { kind: ErrorKind::Protocol, message: msg, code: 9u32 } }

/// The dynamic table (2.3.2): newest entry last.
pub(pkg) struct Table {
    entries: List<(str, str)>;
    /// `[size, max size]` in the RFC's accounting (4.1).
    sz: List<usize>;
}

impl Table {
    pub fn new(max: usize) -> Table { Table { entries: List::new(), sz: [0usize, max] } }

    pub fn len(self) -> usize { self.entries.len() }

    pub fn size(self) -> usize { self.sz[0] }

    pub fn max_size(self) -> usize { self.sz[1] }

    /// Entry `i` of the combined index space (static then dynamic).
    fn get(self, i: usize) throws (HttpError) -> (str, str) {
        if i == 0 { throw err("index 0"); }
        if i <= 61 { return STATIC[i - 1]; }
        let d = i - 62;
        if d >= self.entries.len() { throw err(f"index {i} out of range"); }
        self.entries[self.entries.len() - 1 - d]
    }

    fn evict_to(self, limit: usize) {
        while self.sz[0] > limit && !self.entries.is_empty() {
            let (n, v) = self.entries.remove(0);
            self.sz[0] = self.sz[0] - (n.len() + v.len() + 32);
        }
    }

    pub fn set_max(self, max: usize) {
        self.sz[1] = max;
        self.evict_to(max);
    }

    fn add(self, name: str, value: str) {
        let s = name.len() + value.len() + 32;
        self.evict_to(if s > self.sz[1] { 0usize } else { self.sz[1] - s });
        if s <= self.sz[1] {
            self.entries.push((name, value));
            self.sz[0] = self.sz[0] + s;
        }
    }

    /// `(exact index, name index)` for a field; 0 when absent.
    fn find(self, name: str, value: str) -> (usize, usize) {
        let by_name = 0usize;
        for i in 0usize..61usize {
            let (n, v) = STATIC[i];
            if n == name {
                if v == value { return (i + 1, i + 1); }
                if by_name == 0 { by_name = i + 1; }
            }
        }
        let k = self.entries.len();
        for d in 0..k {
            let (n, v) = self.entries[k - 1 - d];
            if n == name {
                if v == value { return (62 + d, if by_name == 0 { 62 + d } else { by_name }); }
                if by_name == 0 { by_name = 62 + d; }
            }
        }
        (0usize, by_name)
    }
}

// Integer and string primitives (RFC 7541 5.1, 5.2).

/// An integer with an `n`-bit prefix; `flags` fill the high bits of the
/// first byte.
pub(pkg) fn put_int(out: List<u8>, flags: u8, n: u32, v: usize) {
    let max = (1usize << n as usize) - 1;
    if v < max {
        out.push(flags | v as u8);
        return;
    }
    out.push(flags | max as u8);
    let r = v - max;
    while r >= 128 {
        out.push((r % 128) as u8 | 0x80u8);
        r = r / 128;
    }
    out.push(r as u8);
}

fn put_str(out: List<u8>, s: str, huff: bool) {
    let b = s.as_bytes();
    if huff {
        let hl = huffman::encoded_len(b);
        if hl <= b.len() {
            put_int(out, 0x80u8, 7u32, hl);
            huffman::encode(b, out);
            return;
        }
    }
    put_int(out, 0u8, 7u32, b.len());
    out.extend(b);
}

/// A cursor over a header block.
struct Rd {
    b: List<u8>;
    at: List<usize>;
}

impl Rd {
    fn more(self) -> bool { self.at[0] < self.b.len() }

    fn byte(self) throws (HttpError) -> u8 {
        let i = self.at[0];
        if i >= self.b.len() { throw err("truncated header block"); }
        self.at[0] = i + 1;
        self.b[i]
    }

    fn integer(self, n: u32) throws (HttpError) -> usize {
        let max = (1usize << n as usize) - 1;
        let v = (try self.byte()) as usize & max;
        if v < max { return v; }
        let shift = 0usize;
        loop {
            let b = try self.byte();
            if shift > 28 { throw err("integer overflow"); }
            v += ((b & 0x7Fu8) as usize) << shift;
            shift += 7;
            if b & 0x80u8 == 0u8 { break; }
        }
        v
    }

    fn string(self, max: usize) throws (HttpError) -> str {
        let i = self.at[0];
        if i >= self.b.len() { throw err("truncated header block"); }
        let huff = self.b[i] & 0x80u8 != 0u8;
        let n = try self.integer(7u32);
        let at = self.at[0];
        if n > self.b.len() - at { throw err("truncated string"); }
        if n > max { throw HttpError { kind: ErrorKind::TooLarge, message: "header field too large", code: 11u32 }; }
        self.at[0] = at + n;
        let raw = self.b[at:at + n];
        if huff { return utf8_lossy(try huffman::decode(raw)); }
        utf8_lossy(raw.to_list())
    }
}

/// Decoder state for one direction of a connection.
pub(pkg) struct Decoder {
    pub table: Table;
    /// `[limit]`: the largest table size the peer may choose (our
    /// SETTINGS_HEADER_TABLE_SIZE).
    limit: List<usize>;
}

impl Decoder {
    pub fn new(limit: usize = 4096) -> Decoder { Decoder { table: Table::new(limit), limit: [limit] } }

    /// Decode a complete header block; throws a compression error
    /// (code 9), or `TooLarge` past `max_list` bytes of fields (4.1
    /// accounting).
    pub fn decode(self, block: List<u8>, max_list: usize = 1usize << 20usize) throws (HttpError) -> List<(str, str)> {
        let r = Rd { b: block, at: [0usize] };
        let out: List<(str, str)> = List::new();
        let total = 0usize;
        let fields = false;
        while r.more() {
            let b = block[r.at[0]];
            if b & 0x80u8 != 0u8 {
                out.push(try self.table.get(try r.integer(7u32)));
                fields = true;
            } else if b & 0xC0u8 == 0x40u8 {
                let (n, v) = try self.literal(r, 6u32, max_list);
                self.table.add(n, v);
                out.push((n, v));
                fields = true;
            } else if b & 0xE0u8 == 0x20u8 {
                // Size updates only at the start of a block (4.2).
                if fields { throw err("table size update after a field"); }
                let m = try r.integer(5u32);
                if m > self.limit[0] { throw err("table size update over the limit"); }
                self.table.set_max(m);
            } else {
                out.push(try self.literal(r, 4u32, max_list));
                fields = true;
            }
            let (n, v) = out.last() ?? ("", "");
            total += n.len() + v.len() + 32;
            if total > max_list { throw HttpError { kind: ErrorKind::TooLarge, message: "header list too large", code: 11u32 }; }
        }
        out
    }

    fn literal(self, r: Rd, prefix: u32, max: usize) throws (HttpError) -> (str, str) {
        let idx = try r.integer(prefix);
        let name = if idx == 0 { try r.string(max) } else { (try self.table.get(idx)).0 };
        (name, try r.string(max))
    }
}

/// Encoder state for one direction of a connection.
pub(pkg) struct Encoder {
    pub table: Table;
    pub huffman: bool;
    /// `[pending table size update or usize::MAX, smallest since the
    /// last block]` (4.2: the smallest is signalled first).
    upd: List<usize>;
}

const NO_UPDATE: usize = 0xFFFFFFFFusize;

impl Encoder {
    pub fn new(huffman: bool = true) -> Encoder {
        Encoder { table: Table::new(4096), huffman: huffman, upd: [NO_UPDATE, NO_UPDATE] }
    }

    /// Use a table of `max` bytes (the peer's SETTINGS_HEADER_TABLE_SIZE,
    /// capped by us); announced in the next block.
    pub fn set_max(self, max: usize) {
        let m = if max > 4096 { 4096usize } else { max };
        if m == self.table.max_size() && self.upd[0] == NO_UPDATE { return; }
        if self.upd[1] == NO_UPDATE || m < self.upd[1] { self.upd[1] = m; }
        self.upd[0] = m;
        self.table.set_max(m);
    }

    /// Encode `fields` (names lowercase, pseudo-fields first).
    pub fn encode(self, fields: List<(str, str)>) -> List<u8> {
        let out: List<u8> = List::new();
        if self.upd[0] != NO_UPDATE {
            if self.upd[1] < self.upd[0] { put_int(out, 0x20u8, 5u32, self.upd[1]); }
            put_int(out, 0x20u8, 5u32, self.upd[0]);
            self.upd[0] = NO_UPDATE;
            self.upd[1] = NO_UPDATE;
        }
        for (n, v) in fields {
            let (exact, by_name) = self.table.find(n, v);
            if exact > 0 {
                put_int(out, 0x80u8, 7u32, exact);
                continue;
            }
            if n == "authorization" || n == "proxy-authorization" || n == "cookie" && v.len() < 20 {
                // Never indexed (6.2.3, 7.1.3).
                put_int(out, 0x10u8, 4u32, by_name);
            } else {
                put_int(out, 0x40u8, 6u32, by_name);
                self.table.add(n, v);
            }
            if by_name == 0 { put_str(out, n, self.huffman); }
            put_str(out, v, self.huffman);
        }
        out
    }
}
