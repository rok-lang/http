// Tests: the message model, HTTP/1.1 parsing and smuggling cases,
// HPACK vectors (RFC 7541 Appendix C), HTTP/2 framing, loopback client
// and server for each version.

mod model;
mod h1;

pub fn expect(ok: bool, what: str) {
    if !ok { panic(f"check failed: {what}"); }
}

/// Whether `f` throws.
pub fn fails(f: fn() throws) -> bool {
    try f() catch _ { return true; };
    false
}
